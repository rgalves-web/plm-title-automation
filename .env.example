# Copy this file to .env and fill in your real values.
# .env is listed in .gitignore and must NEVER be committed.

# Anthropic API key for LLM extraction (optional — LLM mode is disabled if not set)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default Claude model used for extraction
# PLM_LLM_MODEL=claude-haiku-4-5-20251001

# --- Case File (src/casefile — VS1) ---
# PostgreSQL local; criar role e bancos uma vez (docs/CASEFILE_VS1.md).
CASEFILE_DSN=postgresql://plm:sua-senha-aqui@localhost:5432/plm_casefile
CASEFILE_TEST_DSN=postgresql://plm:sua-senha-aqui@localhost:5432/plm_casefile_test
# Raiz do projeto do cliente (referencias e pastas de unit sao lidas NO LUGAR)
CASEFILE_PROJECT_ROOT=C:\Users\Renato\PURPLE LAND MGMT\BKV122TX - Project Emirates
# Teto duro por unit em USD (default 25; fallback MINORH_TETO_UNIT_USD)
# CASEFILE_TETO_UNIT_USD=25
# Modelos (defaults: claude-opus-5 / claude-haiku-4-5-20251001)
# CASEFILE_MODELO=claude-opus-5
# CASEFILE_MODELO_TRIAGEM=claude-haiku-4-5-20251001
