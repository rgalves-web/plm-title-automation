{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plm.local/agentes/esquemas/verificacao.json",
  "title": "verificacao",
  "description": "Registro de uma verificação cega de claim (Verificador, família B).",
  "$comment": "Formato existente: tabela verifications (0006 + 0007) e src/casefile/verificador.py::verificar_pergunta. `verifier_value` é o que o modelo B devolve ({valor, trecho, evidencia_suficiente}); `verdict` e `comparison` são preenchidos pelo código na comparação determinística, nunca pelo modelo. Vocabulário de veredito do banco: concordancia (a ficha escreve 'concordante'). status/invalidation_reason: 0007 (ficha, regra 2).",
  "type": "object",
  "required": ["claim_id", "question", "verdict", "verifier_model", "verifier_value", "source_sha256", "page", "prompt_sha256", "raw_response", "request_id", "status"],
  "additionalProperties": false,
  "properties": {
    "claim_id": {"type": "integer", "minimum": 1},
    "question": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["concordancia", "divergencia", "evidencia_insuficiente", "nao_verificavel"]},
    "verifier_model": {"type": "string", "minLength": 1},
    "verifier_value": {
      "type": "object",
      "properties": {
        "valor": {},
        "trecho": {"type": "string"},
        "evidencia_suficiente": {"type": "boolean"}
      }
    },
    "comparison": {"type": "object"},
    "cost_usd": {"type": "number", "minimum": 0},
    "status": {"enum": ["valida", "invalidada"]},
    "invalidation_reason": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page": {"type": "string", "minLength": 1},
    "evidence_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_response": {"type": "string"},
    "request_id": {"type": "string"},
    "model_params": {"type": "object"}
  },
  "if": {"properties": {"status": {"const": "invalidada"}}, "required": ["status"]},
  "then": {"required": ["invalidation_reason"], "properties": {"invalidation_reason": {"minLength": 1}}}
}
