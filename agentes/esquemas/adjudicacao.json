{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plm.local/agentes/esquemas/adjudicacao.json",
  "title": "adjudicacao",
  "description": "Saída do Árbitro: desfecho de uma divergência entre Examinador e Verificador.",
  "$comment": "Ficha arbitro.md, regras 1–3: resolve só com página e trecho lidos; três desfechos (mantido, corrigido com novo claim e antigo substituído, escalado); divergência material que toca conclusão de title vai ao operador com opções e evidências (campo material_conclusao_titulo). `novo_claim` reusa claims.json#/$defs/claim; o status 'substituido' do antigo é o de claims (0001). `escalonamento` segue as colunas de escalations propostas em ARQUITETURA_AGENTICA_v1 §6 (motivo, pergunta, opções).",
  "type": "object",
  "required": ["claim_id", "verificacao_id", "desfecho", "material_conclusao_titulo", "justificativa"],
  "additionalProperties": false,
  "properties": {
    "claim_id": {"type": "integer", "minimum": 1},
    "verificacao_id": {"type": "integer", "minimum": 1},
    "desfecho": {"enum": ["mantido", "corrigido", "escalado"]},
    "material_conclusao_titulo": {"type": "boolean"},
    "documento": {"type": "string", "minLength": 1},
    "pagina": {"type": "string", "minLength": 1},
    "trecho": {"type": "string", "minLength": 1},
    "justificativa": {"type": "string", "minLength": 1},
    "novo_claim": {"$ref": "claims.json#/$defs/claim"},
    "escalonamento": {
      "type": "object",
      "required": ["motivo", "pergunta", "opcoes", "evidencias"],
      "additionalProperties": false,
      "properties": {
        "motivo": {"type": "string", "minLength": 1},
        "pergunta": {"type": "string", "minLength": 1},
        "opcoes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2},
        "evidencias": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["documento", "pagina", "trecho"],
            "additionalProperties": false,
            "properties": {
              "documento": {"type": "string", "minLength": 1},
              "pagina": {"type": "string", "minLength": 1},
              "trecho": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"desfecho": {"const": "mantido"}}, "required": ["desfecho"]},
     "then": {"required": ["documento", "pagina", "trecho"]}},
    {"if": {"properties": {"desfecho": {"const": "corrigido"}}, "required": ["desfecho"]},
     "then": {"required": ["documento", "pagina", "trecho", "novo_claim"]}},
    {"if": {"properties": {"desfecho": {"const": "escalado"}}, "required": ["desfecho"]},
     "then": {"required": ["escalonamento"]}},
    {"if": {"properties": {"material_conclusao_titulo": {"const": true}}, "required": ["material_conclusao_titulo"]},
     "then": {"properties": {"desfecho": {"const": "escalado"}}}}
  ]
}
